# ranking.html loads ranking.txt, so both files must remain readable.
# The previous Options/Require version returned HTTP 500 on the RCNP user
# directory, so this file uses the legacy host-access directives instead.
<Files "ranking.html">
    Order Deny,Allow
    Allow from all
</Files>
<Files "ranking.txt">
    Order Deny,Allow
    Allow from all
</Files>

# Deny every other file in this directory.
<FilesMatch "^(?!ranking\.html$|ranking\.txt$).*$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
